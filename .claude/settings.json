{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-pull.sh\"",
            "timeout": 30,
            "statusMessage": "Trayendo lo último del repositorio…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-pull.sh\"",
            "timeout": 30,
            "statusMessage": "Trayendo lo último del repositorio…"
          }
        ]
      }
    ]
  }
}
