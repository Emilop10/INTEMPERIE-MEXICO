{%- comment -%}
  Barra fija de compra en celular (30 sep, MANUAL §69; rediseñada el 19 oct, §100-§101).

  Razón de existir: en un iPhone de 390×844, el botón "Agregar al carrito"
  queda entre 1,200 y 1,770px de alto, o sea fuera de la primera pantalla.
  El 99% del tráfico de la campaña llega desde el navegador de Facebook en
  celular. Esta barra se ve desde la primera pantalla y solo se esconde
  mientras el botón original está a la vista, para que nunca haya dos
  botones juntos.

  Hasta el 19 oct aparecía solo *después* de pasar el botón, así que la
  primera pantalla no tenía ninguna acción de compra: 1 carrito en 154
  vistas (MANUAL §99-§100).

  Diseño: es la pareja del encabezado. Usa el mismo cristal oscuro con
  desenfoque (.header-wrapper en brand-tokens.css), la misma línea
  divisoria (--im-divider-strong), el precio con la misma tipografía mono
  de la ficha (.product__info-container .price) y la línea de envío con
  los mismos colores que .im-envio-precio. El botón es el mismo del
  formulario (var(--brand-accent), pastilla, peso normal, 1px de
  espaciado). Nada de sombras ni de pesos distintos.

  No tiene lógica de carrito propia: el botón hace click() sobre el botón
  real del formulario de Dawn (#ProductSubmitButton-…). Así el carrito
  lateral, las variantes y el evento AddToCart del pixel siguen pasando
  por el único camino que ya está probado (§55, §66).

  Las burbujas de WhatsApp y de Cartucho (Zipchat, que vive en un shadow
  DOM abierto) siguen escondidas hasta pasar el botón original, como
  antes; desde ahí suben para no tapar la barra.

  La clase que marca el body es im-en-ficha. Hasta el 19 oct era
  im-ficha, que es también la clase del bloque "Ficha técnica"
  (brand-tokens.css): el body heredaba sus 26px de margen y 20px de
  relleno y todas las fichas cargaban con una franja negra vacía de
  ~47px arriba del aviso de envío (MANUAL §102).

  Parámetros: product, section_id
{%- endcomment -%}

{%- if product.available -%}
  {%- liquid
    assign im_umbral = settings.envio_umbral_centavos | default: 79900
    assign im_costo = settings.envio_costo | default: '$189'
    assign im_tiempo = settings.envio_tiempo | default: '2 a 7 días hábiles'
    assign im_dias = im_tiempo | split: ' a '
    assign im_dias_min = im_dias | first | plus: 0
    assign im_dias_max = im_dias | last | split: ' ' | first | plus: 0
    assign im_variante = product.selected_or_first_available_variant
    if settings.currency_code_enabled
      assign im_precio_texto = im_variante.price | money_with_currency
    else
      assign im_precio_texto = im_variante.price | money
    endif
  -%}
  <div class="im-barra-compra" id="ImBarraCompra-{{ section_id }}" aria-hidden="true" hidden>
    <div class="im-barra-compra__info">
      <span class="im-barra-compra__precio" data-im-precio>{{ im_precio_texto }}</span>
      <span class="im-barra-compra__envio" data-im-envio data-im-umbral="{{ im_umbral }}">
        <span data-im-envio-gratis{% if im_variante.price < im_umbral %} hidden{% endif %}>
          <strong>Envío gratis</strong> · <span data-im-entrega data-formato="corto" data-min="{{ im_dias_min }}" data-max="{{ im_dias_max }}">en {{ im_tiempo }}</span>
        </span>
        <span data-im-envio-costo{% if im_variante.price >= im_umbral %} hidden{% endif %}>
          + <strong>{{ im_costo }} de envío</strong>
        </span>
      </span>
    </div>
    <button type="button" class="im-barra-compra__boton" tabindex="-1">
      Agregar al carrito
    </button>
  </div>

  <style>
    .im-barra-compra { display: none; }
    @media screen and (max-width: 749px) {
      .im-barra-compra {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 997; /* debajo de las burbujas (998/999) y del carrito (1000) */
        display: flex;
        align-items: center;
        gap: 14px;
        /* --im-bajo (theme.liquid): en Safari de iOS 26 el fondo de la barra
           llega hasta abajo, pero el botón queda por encima de la barra
           flotante de Safari (MANUAL §88). */
        padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px) + var(--im-bajo, 0px));
        /* Mismo cristal que el encabezado (.header-wrapper), pero más
           opaco: al cargar, la barra queda justo encima del precio de la
           ficha y con 0.72 se leía doble. */
        background: rgba(0, 0, 0, 0.9);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        backdrop-filter: saturate(180%) blur(20px);
        border-top: 1px solid var(--im-divider-strong);
        transform: translateY(110%);
        transition: transform 320ms cubic-bezier(.4, 0, .6, 1);
      }
      .im-barra-compra[hidden] { display: flex; visibility: hidden; }
      .im-barra-compra.is-visible { transform: none; visibility: visible; }
      /* Con el menú, el buscador o el carrito abiertos (Dawn pone
         overflow-hidden-* en el body) la barra se guarda: no tiene
         sentido "Agregar al carrito" encima del menú. */
      body[class*="overflow-hidden"] .im-barra-compra.is-visible { transform: translateY(110%); }
      .im-barra-compra__info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
        flex: 1;
      }
      /* Igual que el precio de la ficha: mono, tabular, peso normal. */
      .im-barra-compra__precio {
        font-family: var(--font-mono-family);
        font-variant-numeric: tabular-nums;
        font-size: 16px;
        font-weight: 400;
        letter-spacing: 0.08em;
        line-height: 1.3;
        color: #F5F5F7;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      /* Igual que .im-envio-precio, en chico. */
      .im-barra-compra__envio {
        font-family: var(--font-body-family);
        font-size: 12px;
        line-height: 1.3;
        color: #D9D9DE;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .im-barra-compra__envio strong {
        color: #57B58A;
        font-weight: 600;
      }
      /* Calcado del botón del formulario (.product-form__submit). */
      .im-barra-compra__boton {
        flex: none;
        min-height: 45px;
        padding: 0 22px;
        border: 0;
        border-radius: var(--brand-radius-pill);
        /* Los mismos colores que el botón del formulario (esquema oscuro
           de Dawn). --brand-accent no sirve aquí: depende de
           prefers-color-scheme y la tienda siempre es oscura. */
        background: #57B58A;
        color: #06120D;
        font-family: var(--font-body-family);
        font-size: 15px;
        font-weight: 400;
        letter-spacing: 1px;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
      }
      .im-barra-compra__boton:focus-visible {
        outline: 2px solid #F5F5F7;
        outline-offset: 2px;
      }
      .im-barra-compra__boton:disabled { opacity: 0.55; cursor: default; }

      /* La barra vive desde el inicio: el pie de página no debe quedar
         tapado al llegar hasta abajo. */
      body.im-en-ficha {
        padding-bottom: calc(66px + env(safe-area-inset-bottom, 0px) + var(--im-bajo, 0px));
      }

      /* En la ficha, las burbujas se esconden mientras se ve la zona de
         compra (foto, precio, envío, existencias: ahí tapaban el texto) y
         reaparecen arriba de la barra en cuanto el botón queda atrás. */
      body.im-en-ficha .im-wa {
        transition: bottom 0.22s ease, opacity 0.2s ease;
      }
      body.im-en-ficha:not(.im-barra-activa) .im-wa {
        opacity: 0;
        pointer-events: none;
      }
      body.im-barra-activa .im-wa {
        bottom: calc(84px + env(safe-area-inset-bottom, 0px) + var(--im-bajo, 0px));
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .im-barra-compra, body.im-barra-activa .im-wa { transition: none; }
    }
  </style>

  <script>
    (function () {
      var barra = document.getElementById('ImBarraCompra-{{ section_id }}');
      var original = document.getElementById('ProductSubmitButton-{{ section_id }}');
      if (!barra || !original || !('IntersectionObserver' in window)) return;
      var boton = barra.querySelector('.im-barra-compra__boton');
      var precio = barra.querySelector('[data-im-precio]');
      var envio = barra.querySelector('[data-im-envio]');
      var envioGratis = barra.querySelector('[data-im-envio-gratis]');
      var envioCosto = barra.querySelector('[data-im-envio-costo]');
      var umbral = parseInt(envio.getAttribute('data-im-umbral'), 10);
      var precioFuente = document.getElementById('price-{{ section_id }}');
      var movil = window.matchMedia('(max-width: 749px)');

      // Cartucho (Zipchat) vive en un shadow DOM abierto: se le inyecta una
      // regla que solo aplica cuando el host lleva la clase im-sube.
      function prepararZipchat() {
        var host = document.getElementById('zipchat-shadow-host');
        if (!host || !host.shadowRoot || host.shadowRoot.getElementById('im-zipchat-sube')) return host;
        var st = document.createElement('style');
        st.id = 'im-zipchat-sube';
        st.textContent = '#widget-chat-container{transition:bottom .22s ease,opacity .2s ease}'
          + ':host(.im-sube) #widget-chat-container{bottom:88px !important}'
          + ':host(.im-oculta) #widget-chat-container{opacity:0;pointer-events:none}';
        host.shadowRoot.appendChild(st);
        return host;
      }

      // si: la barra se ve. pasado: el botón original ya quedó arriba
      // (solo entonces aparecen las burbujas, encima de la barra).
      var estado = { si: false, pasado: false };
      function mostrar(si, pasado) {
        estado = { si: si, pasado: pasado };
        var ver = si && movil.matches;
        var sube = pasado && movil.matches;
        barra.hidden = false;
        barra.classList.toggle('is-visible', ver);
        barra.setAttribute('aria-hidden', ver ? 'false' : 'true');
        boton.tabIndex = ver ? 0 : -1;
        document.body.classList.toggle('im-barra-activa', sube);
        var host = prepararZipchat();
        if (host) {
          host.classList.toggle('im-sube', sube);
          // Solo se esconde el lanzador cerrado (~64px): si el cliente ya
          // abrió el chat, nunca se le oculta al subir por la página.
          var cont = host.shadowRoot && host.shadowRoot.getElementById('widget-chat-container');
          var cerrado = !cont || cont.getBoundingClientRect().height < 100;
          host.classList.toggle('im-oculta', movil.matches && !sube && cerrado);
        }
      }
      document.body.classList.add('im-en-ficha');
      // Zipchat carga después que la página: se reintenta hasta que exista.
      var intentos = 0;
      var espera = setInterval(function () {
        if (prepararZipchat() || ++intentos > 20) {
          clearInterval(espera);
          mostrar(estado.si, estado.pasado);
        }
      }, 500);

      // Visible siempre que el botón real no esté en pantalla: antes de
      // llegar a él (primera pantalla) y después de pasarlo.
      new IntersectionObserver(function (entradas) {
        var e = entradas[0];
        mostrar(!e.isIntersecting, !e.isIntersecting && e.boundingClientRect.top < 0);
      }).observe(original);

      boton.addEventListener('click', function () {
        if (original.disabled) return;
        original.click();
      });

      // Precio, envío y disponibilidad siguen a la variante elegida: Dawn
      // re-renderiza #price-… y cambia el disabled del botón real.
      function sincronizar() {
        if (precioFuente) {
          var ultimo = precioFuente.querySelector('.price-item--last');
          var texto = ultimo && ultimo.textContent.trim();
          if (texto) {
            precio.textContent = texto;
            // "$ 1,749.00 MXN" → 174900 centavos. Si no se entiende, se deja
            // la línea de envío como estaba.
            var centavos = Math.round(parseFloat(texto.replace(/[^0-9.]/g, '')) * 100);
            if (!isNaN(centavos) && !isNaN(umbral)) {
              envioGratis.hidden = centavos < umbral;
              envioCosto.hidden = centavos >= umbral;
            }
          }
        }
        boton.disabled = original.disabled;
        boton.textContent = original.disabled ? 'Agotado' : 'Agregar al carrito';
      }
      if (precioFuente) new MutationObserver(sincronizar).observe(precioFuente, { childList: true, subtree: true, characterData: true });
      new MutationObserver(sincronizar).observe(original, { attributes: true, attributeFilter: ['disabled'] });
      sincronizar();
    })();
  </script>
{%- endif -%}
