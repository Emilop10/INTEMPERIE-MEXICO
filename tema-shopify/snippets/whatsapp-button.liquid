{%- comment -%}
  Botón flotante de WhatsApp.

  Razón de existir: el mejor público de la campaña de Meta resultó ser
  hombres de 35-65 años (CTR 6.49% en 55-64 contra 2.26% en 25-34), y ese
  comprador rara vez le da su tarjeta a una tienda que no conoce sin
  preguntar antes. El sitio recibe visitas de tráfico pagado que hoy se
  van en silencio; esto captura esa demanda ya pagada.

  Va abajo a la IZQUIERDA a propósito: Cartucho (el chatbot de Zipchat) se
  monta abajo a la derecha, y dos burbujas encimadas no se pueden tocar en
  móvil.

  En la ficha de producto el mensaje se rellena con el nombre y el enlace,
  así el mensaje que llega ya dice de qué producto se trata — sin eso, la
  conversación arranca con "¿de cuál me hablas?" y se pierde la mitad.
{%- endcomment -%}

{%- if settings.wa_show and settings.wa_number != blank -%}
  {%- liquid
    assign wa_num = settings.wa_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
    assign wa_msg = settings.wa_message
    if template contains 'product' and product
      assign wa_msg = settings.wa_message_product
        | replace: '[producto]', product.title
        | append: ' '
        | append: shop.url
        | append: product.url
    endif
  -%}
  <a
    class="im-wa"
    href="https://wa.me/{{ wa_num }}?text={{ wa_msg | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ 'Escríbenos por WhatsApp' }}"
  >
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"/>
      <path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 15.71a8.2 8.2 0 0 1-5.8 2.4h-.01c-1.53 0-3.04-.41-4.35-1.19l-.31-.19-3.23.85.86-3.15-.2-.32a8.16 8.16 0 0 1-1.25-4.35c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.18 8.23z"/>
    </svg>
    <span class="im-wa-label">{{ settings.wa_label }}</span>
  </a>

  <style>
    .im-wa {
      position: fixed;
      left: 16px;
      /* env(safe-area-inset-bottom) evita que quede debajo de la barra de
         gestos del iPhone, donde no se puede tocar. */
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      z-index: 998; /* debajo del drawer del carrito, encima del contenido */
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 1.1rem 1.6rem 1.1rem 1.3rem;
      border-radius: 999px;
      background: #25D366;
      color: #fff;
      text-decoration: none;
      font-size: 1.4rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .im-wa:hover,
    .im-wa:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.34);
      color: #fff;
    }
    .im-wa svg { flex: none; }

    /* En móvil solo el ícono: la etiqueta ocuparía media pantalla y el
       botón de WhatsApp se reconoce sin texto. */
    @media screen and (max-width: 749px) {
      .im-wa { padding: 1.3rem; gap: 0; }
      .im-wa-label { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .im-wa { transition: none; }
      .im-wa:hover, .im-wa:focus-visible { transform: none; }
    }
  </style>
{%- endif -%}
