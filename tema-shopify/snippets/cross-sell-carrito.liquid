{%- comment -%}
  Sugerencias para cerrar la brecha hacia envío gratis. Requiere `cart`.

  No crea ninguna colección nueva: reusa el mismo mapa
  handle→subcategorías que ya usan sections/related-products.liquid:42,58-68
  y snippets/cart-drawer.liquid:137 (departamento de un producto → sus
  subcategorías). Si ese mapa cambia en esos archivos, cambia también
  aquí — son tres copias; consolidarlas es una mejora aparte, no de
  esta ola.

  El departamento se deriva del PRIMER producto del carrito. Las
  subcategorías de cada departamento van ordenadas de más barato a
  más caro a propósito (para "rifles-y-pistolas-de-aire" se ofrecen
  consumibles — diábolos, CO2 — no más rifles: nadie agrega un
  segundo rifle de $3,000 para cerrar una brecha de $200).

  Dos cubetas de precio: A = 55%-125% de la brecha, cierra el envío
  gratis de un tirón (sube el ticket de verdad); B = relleno barato,
  solo si A no juntó 3. Nunca se sugiere algo ya en el carrito
  (deduplicado por product_id) ni algo agotado.

  `collections[handle]` con un handle inexistente devuelve un
  EmptyDrop TRUTHY — por eso se valida `subcat.title != blank`, mismo
  patrón que related-products.liquid:89. Los 22 handles de abajo se
  verificaron uno por uno con curl antes de este despliegue (Ola 7,
  24 ago) — si alguno se renombra o borra, esa subcategoría se salta
  en silencio y la relevancia baja sin error visible; no se enumeran
  como pendiente porque related-products.liquid ya depende de los
  mismos.

  No imprime nada si el carrito está vacío, si ya alcanzó el umbral,
  o si ningún producto calificó — nunca un hueco raro.
{%- endcomment -%}
{%- liquid
  assign umbral = settings.envio_umbral_centavos | default: 79900
  assign brecha = umbral | minus: cart.total_price
-%}
{%- if cart != empty and brecha > 0 -%}
  {%- liquid
    assign ids_en_carrito = ','
    for line in cart.items
      assign ids_en_carrito = ids_en_carrito | append: line.product_id | append: ','
    endfor

    assign department_handles = 'todo-pesca,miras-y-binoculares,diabolos-y-municiones,rifles-y-pistolas-de-aire' | split: ','
    assign dept_handle = ''
    for c in cart.items.first.product.collections
      if department_handles contains c.handle
        assign dept_handle = c.handle
        break
      endif
    endfor

    assign subcat_handles = '' | split: ','
    case dept_handle
      when 'todo-pesca'
        assign subcat_handles = 'anzuelos,plomos-y-lastres,destorcedores,flotadores,cucharillas,senuelos,hilos-y-lineas,cajas,carretes,canas,combos' | split: ','
      when 'miras-y-binoculares'
        assign subcat_handles = 'accesorios-de-optica,monoculares,binoculares,miras-telescopicas' | split: ','
      when 'diabolos-y-municiones'
        assign subcat_handles = 'diabolos-calibre-4-5mm,diabolos-calibre-5-5mm,municiones-airsoft-6mm,diabolos-calibre-6-35mm,co2-y-cartuchos' | split: ','
      when 'rifles-y-pistolas-de-aire'
        assign subcat_handles = 'co2-y-cartuchos,diabolos-calibre-4-5mm,diabolos-calibre-5-5mm,municiones-airsoft-6mm,accesorios-de-optica' | split: ','
      else
        assign subcat_handles = 'anzuelos,plomos-y-lastres,co2-y-cartuchos,diabolos-calibre-4-5mm' | split: ','
    endcase

    assign techo = brecha | times: 125 | divided_by: 100
    assign piso = brecha | times: 55 | divided_by: 100
    assign tier_a = ''
    assign tier_b = ''
    assign n_a = 0
    assign n_b = 0

    for h in subcat_handles
      if n_a >= 3
        break
      endif
      assign subcat = collections[h]
      if subcat != blank and subcat.title != blank
        for p in subcat.products limit: 8
          if n_a >= 3
            break
          endif
          assign marca = ',' | append: p.id | append: ','
          unless p.available
            continue
          endunless
          if ids_en_carrito contains marca
            continue
          endif
          if p.price > techo or p.price <= 0
            continue
          endif
          if p.price >= piso
            assign tier_a = tier_a | append: p.handle | append: ','
            assign n_a = n_a | plus: 1
          elsif n_b < 3
            assign tier_b = tier_b | append: p.handle | append: ','
            assign n_b = n_b | plus: 1
          endif
        endfor
      endif
    endfor

    assign elegidos = tier_a | append: tier_b | split: ','
  -%}

  {%- if elegidos.size > 0 -%}
    {%- assign brecha_pesos = brecha | divided_by: 100.0 | ceil -%}
    <div class="imx-crosssell" data-imx-crosssell>
      <p class="imx-crosssell__title">Agrega ${{ brecha_pesos }} más y tu envío es gratis</p>
      <ul class="imx-crosssell__list" role="list">
        {%- for handle in elegidos limit: 3 -%}
          {%- assign p = all_products[handle] -%}
          {%- if p != blank and p.title != blank -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            <li class="imx-crosssell__item">
              <a class="imx-crosssell__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                {%- if p.featured_image -%}
                  {{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 60, height: 60, alt: '' }}
                {%- endif -%}
              </a>
              <div class="imx-crosssell__body">
                <a class="imx-crosssell__name" href="{{ p.url }}">{{ p.title }}</a>
                <span class="imx-crosssell__price">{{ p.price | money }}</span>
              </div>
              {%- if p.variants.size == 1 and v.available -%}
                <button type="button" class="imx-crosssell__add" data-imx-add="{{ v.id }}" aria-label="Agregar {{ p.title | escape }} al carrito">Agregar</button>
              {%- else -%}
                <a class="imx-crosssell__add imx-crosssell__add--link" href="{{ p.url }}">Ver</a>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
{%- endif -%}
